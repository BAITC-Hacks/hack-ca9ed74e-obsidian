# Все основные функции работают без внешнего AI и без ключей.
PORT=3001
HOST=127.0.0.1
# Необязательный API с форматом Chat Completions. Полный URL endpoint.
# Должен поддерживать response_format: {"type":"json_object"}.
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=
# Лимит ожидания AI: от 500 до 7000 мс. Затем локальное объяснение.
AI_TIMEOUT_MS=4500
